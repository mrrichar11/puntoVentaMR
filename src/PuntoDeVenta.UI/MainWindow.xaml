<ui:FluentWindow x:Class="PuntoDeVenta.UI.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:asistenteViews="clr-namespace:PuntoDeVenta.UI.Views.Asistente"
                  xmlns:converters="clr-namespace:PuntoDeVenta.UI.Converters"
                  mc:Ignorable="d"
                  Title="{Binding Titulo}"
                  Icon="pack://application:,,,/Assets/mr_sys_icon.ico"
                  Height="780"
                  Width="1280"
                  WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TITLEBAR NATIVO DE WINDOWS 11 -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Titulo}">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal">
                    <!-- Estado de Caja -->
                    <Border Margin="12,0,6,0"
                            Padding="10,4"
                            CornerRadius="6"
                            Background="{Binding ColorFondoEstadoCaja}">
                        <TextBlock Text="{Binding EstadoCajaTexto}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Badge Licencia -->
                    <Border Margin="0,0,6,0"
                            Padding="8,4"
                            CornerRadius="6"
                            Background="{Binding LicenciaBadgeColor}">
                        <TextBlock Text="{Binding LicenciaBadgeTexto}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Usuario Activo -->
                    <Border Padding="8,4"
                            CornerRadius="6"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding UsuarioActivoTexto}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- BOTÓN COPILOTO IA MR. BOT EN LA BARRA SUPERIOR (SIEMPRE VISIBLE, NUNCA TAPA DATOS) -->
                    <Button Command="{Binding ToggleAsistenteFlotanteCommand}"
                            ToolTip="Mr. Bot • Copiloto Inteligente IA (Presioná F1 desde cualquier pantalla)"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="#18181B"
                                        BorderBrush="#00E5FF"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="10,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#00E5FF" Opacity="0.4" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🤖" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Mr. Bot IA"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="#00E5FF"
                                                   VerticalAlignment="Center" />
                                        <Border Background="#00E5FF"
                                                CornerRadius="3"
                                                Padding="4,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="F1"
                                                       FontSize="8"
                                                       FontWeight="ExtraBold"
                                                       Foreground="#121214"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#22272E" />
                                        <Setter TargetName="border" Property="BorderBrush" Value="#33ECFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#00E5FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- BADGE NUEVA VERSIÓN DISPONIBLE -->
                    <Border Margin="10,0,0,0"
                            Padding="8,4"
                            CornerRadius="6"
                            Background="#FEF08A"
                            BorderBrush="#EAB308"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="{Binding HayActualizacionDisponible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="¡Hay una nueva actualización disponible! Abre Configuración -> pestaña Actualizaciones para instalarla con un clic.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NuevaVersionTexto, StringFormat='v{0} disponible'}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#854D0E"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- CUERPO PRINCIPAL CON NAVEGACIÓN -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- BARRA LATERAL FLUENT -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="8">
                <StackPanel>
                    <!-- LOGO / MARCA -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,12">
                        <Grid>
                            <!-- Vista Con Logo Personalizado -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding TieneLogoPersonalizado, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="{Binding LogoRuta}"
                                       MaxHeight="36"
                                       MaxWidth="50"
                                       Stretch="Uniform"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" MaxWidth="140">
                                    <TextBlock Text="{Binding NombreComercio}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="PUNTO DE VENTA"
                                               FontFamily="Consolas, Cascadia Mono, monospace"
                                               FontSize="8.5"
                                               FontWeight="Bold"
                                               Foreground="#888888"
                                               Margin="0,-1,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Vista Monograma Retro-Tech Cuadrado Neón Si No Hay Logo -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding TieneLogoPersonalizado, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Border Background="#121214"
                                        BorderBrush="#00E5FF"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        Width="34"
                                        Height="34"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="SYS"
                                               FontFamily="Consolas, Cascadia Mono, monospace"
                                               FontSize="10"
                                               FontWeight="Black"
                                               Foreground="#00E5FF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NombreComercio}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                               FontWeight="Black"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="INDUMENTARIA POS"
                                               FontFamily="Consolas, Cascadia Mono, monospace"
                                               FontSize="8.5"
                                               FontWeight="Bold"
                                               Foreground="#888888"
                                               Margin="0,-1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Botón Punto de Venta (TPV) -->
                    <ui:Button Content="Punto de Venta"
                               Icon="{ui:SymbolIcon Symbol=ShoppingBag24}"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,6"
                               Padding="12,10"
                               Click="NavItemPos_Click" />

                    <!-- Botón Movimientos de Caja -->
                    <ui:Button Content="Caja &amp; Turnos"
                               Icon="{ui:SymbolIcon Symbol=Money24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,6"
                               Padding="12,10"
                               Click="NavItemCaja_Click" />

                    <!-- Botón Inventario & Stock -->
                    <ui:Button Content="Inventario"
                               Icon="{ui:SymbolIcon Symbol=Box24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,6"
                               Padding="12,10"
                               Click="NavItemInventario_Click" />

                    <!-- Botón Asistente de Carga IA -->
                    <ui:Button Content="🤖 Mr. Bot IA"
                               Icon="{ui:SymbolIcon Symbol=Bot24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,6"
                               Padding="12,10"
                               Click="NavItemAsistente_Click" />

                    <!-- Botón Clientes & Cta Cte -->
                    <ui:Button Content="Clientes / Cta. Cte."
                               Icon="{ui:SymbolIcon Symbol=People24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,6"
                               Padding="12,10"
                               Click="NavItemClientes_Click" />

                    <!-- Botón Proveedores & Compras -->
                    <ui:Button Content="Proveedores / Compras"
                               Icon="{ui:SymbolIcon Symbol=Building24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,6"
                               Padding="12,10"
                               Click="NavItemProveedores_Click" />

                    <!-- Botón Analíticas & Reportes -->
                    <ui:Button Content="Analíticas &amp; Reportes"
                               Icon="{ui:SymbolIcon Symbol=DataTrending24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,6"
                               Padding="12,10"
                               Click="NavItemAnaliticas_Click" />

                    <!-- Botón Configuración del Sistema -->
                    <ui:Button Content="Configuración"
                               Icon="{ui:SymbolIcon Symbol=Settings24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,0,0,6"
                               Padding="12,10"
                               Click="NavItemConfiguracion_Click" />

                    <!-- Separador -->
                    <Separator Margin="0,8,0,8" />

                    <!-- Botón Bloquear Pantalla (Futuro) -->
                    <ui:Button Content="Bloquear Turno"
                               Icon="{ui:SymbolIcon Symbol=LockClosed24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               IsEnabled="False"
                               Margin="0,0,0,6"
                               Padding="12,8" />

                    <!-- Botón Cerrar Sesión -->
                    <ui:Button Content="Cerrar Sesión"
                               Icon="{ui:SymbolIcon Symbol=SignOut24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Margin="0,16,0,6"
                               Padding="12,8"
                               Command="{Binding CerrarSesionCommand}" />
                </StackPanel>
            </Border>

            <!-- ÁREA DE CONTENIDO DINÁMICO -->
            <ContentControl Grid.Column="1"
                            x:Name="MainContentControl"
                            Margin="8" />


            <!-- PANEL DESPLEGABLE / OVERLAY DRAWER DEL ASISTENTE FLOTANTE -->
            <Border Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="430"
                    Margin="0,4,8,8"
                    Panel.ZIndex="100"
                    Visibility="{Binding IsAsistenteFlotanteAbierto, Converter={StaticResource BooleanToVisibilityConverter}}">
                <asistenteViews:AsistenteFlotanteView DataContext="{Binding AsistenteViewModel}" />
            </Border>
        </Grid>

        <!-- STATUS BAR INFERIOR FIJA (RETRO-TECH / NEO-BRUTALISMO MR SYS) -->
        <Border Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0"
                Height="32">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- LADO IZQUIERDO: COMERCIO Y TURNO -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Building24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusBarIzquierdaTexto}"
                               FontFamily="Consolas, Cascadia Mono, Segoe UI Variable"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- LADO DERECHO: FIRMA DISCRETA MR SYS ONLINE -->
                <Border Grid.Column="1"
                        Background="#121214"
                        BorderBrush="#2E2E32"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,3"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Indicador Verde Fósforo Online -->
                        <Ellipse Width="7" Height="7" Fill="#00FF66" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusBarDerechaTexto}"
                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#F4F4F5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
