<ui:FluentWindow x:Class="PuntoDeVenta.UI.Views.Seguridad.ActivacionLicenciaView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   mc:Ignorable="d"
                   Title="[MR_SYS] MR SYS Retail - Activación de Terminal"
                   Icon="pack://application:,,,/Assets/mr_sys_icon.ico"
                   Height="600" Width="580"
                   WindowStartupLocation="CenterScreen"
                   ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BARRA DE TÍTULO CON CRUZ DE CERRAR -->
        <ui:TitleBar Grid.Row="0"
                     Title="[MR_SYS] MR SYS Retail - Activación de Terminal"
                     CloseWindowByDoubleClickOnIcon="False" />

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1" Margin="24,10,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ENCABEZADO NEO-BRUTALISTA RETRO-TECH -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
                <Border Background="#121214"
                        BorderBrush="#2E2E32"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,6"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="[" FontSize="20" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="#888888" VerticalAlignment="Center" />
                        <TextBlock Text="MR_SYS" FontSize="20" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="#00FF66" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Text="]" FontSize="20" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="#888888" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="MR SYS Retail" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="Control de Licenciamiento &amp; Terminal • mrsys.app" FontSize="11" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>

            <!-- CUERPO PRINCIPAL -->
            <StackPanel Grid.Row="1">
                <!-- MENSAJE DE ESTADO -->
                <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding Mensaje}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsMensajeError}" Value="True">
                                        <Setter Property="Foreground" Value="#D13438" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EsMensajeError}" Value="False">
                                        <Setter Property="Foreground" Value="#107C41" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- CÓDIGO DE INSTALACIÓN -->
                <ui:Card Margin="0,0,0,14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Código de Instalación de esta Computadora:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding CodigoInstalacion, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="15"
                                     FontWeight="Bold"
                                     VerticalContentAlignment="Center"
                                     Padding="8,6" />
                            <ui:Button Grid.Column="1"
                                       Content="Copiar"
                                       Icon="{ui:SymbolIcon Symbol=Copy24}"
                                       Appearance="Secondary"
                                       Margin="8,0,0,0"
                                       Command="{Binding CopiarCodigoCommand}" />
                        </Grid>
                        <TextBlock Text="Envía este código a tu proveedor para obtener o renovar tu clave mensual." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </ui:Card>

                <!-- INGRESO DE CLAVE -->
                <ui:Card Margin="0,0,0,14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Clave de Activación Mensual:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ui:TextBox Text="{Binding ClaveActivacionInput, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="ej. PRM-20261005-XXXXXXXX o STD-20261005-XXXXXXXX"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Margin="0,0,0,12" />

                        <ui:Button Content="ACTIVAR / RENOVAR SISTEMA"
                                   Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}"
                                   Appearance="Primary"
                                   Height="44"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding ActivarCommand}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- BOTÓN DE CIERRE Y SOPORTE MR SYS -->
            <DockPanel Grid.Row="2">
                <TextBlock Text="MR SYS Software • Soporte técnico &amp; Activación • mrsys.app"
                           FontSize="11"
                           FontFamily="Consolas, Cascadia Mono, Courier New"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ui:Button Content="Salir"
                           Appearance="Secondary"
                           HorizontalAlignment="Right"
                           Width="90"
                           IsCancel="True"
                           Command="{Binding CerrarCommand}" />
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
