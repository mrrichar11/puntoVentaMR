<ui:FluentWindow x:Class="PuntoDeVenta.UI.Views.Seguridad.LoginView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:converters="clr-namespace:PuntoDeVenta.UI.Converters"
                   mc:Ignorable="d"
                   Title="Acceso de Operador - Punto de Venta"
                   Icon="pack://application:,,,/Assets/mr_sys_icon.ico"
                   Height="600" Width="440"
                   WindowStartupLocation="CenterScreen"
                   ResizeMode="NoResize">

    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BARRA DE TÍTULO CON CRUZ DE CERRAR -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding NombreComercioOIdentidad}"
                     CloseWindowByDoubleClickOnIcon="False" />

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1" Margin="28,10,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ENCABEZADO: LOGO DEL NEGOCIO O MONOGRAMA NEO-BRUTALISTA -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
                <!-- LOGO PERSONALIZADO DEL COMERCIO -->
                <Image Source="{Binding LogoRuta}"
                       MaxHeight="80"
                       MaxWidth="220"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       Visibility="{Binding TieneLogoPersonalizado, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- MONOGRAMA RETRO-TECH POR DEFECTO SI NO HAY LOGO -->
                <Border Background="#121214"
                        BorderBrush="#2E2E32"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,6"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"
                        Visibility="{Binding TieneLogoPersonalizado, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="[" FontSize="20" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="#888888" VerticalAlignment="Center" />
                        <TextBlock Text="MR_SYS" FontSize="20" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="#00FF66" Margin="4,0" VerticalAlignment="Center" />
                        <TextBlock Text="]" FontSize="20" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="#888888" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding NombreComercioOIdentidad}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="Terminal POS • Gestión &amp; Ventas" FontSize="11" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>

            <!-- FORMULARIO DE ACCESO -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- MENSAJE DE ESTADO / ERROR -->
                <Border Margin="0,0,0,14" Padding="10,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding Mensaje}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsMensajeError}" Value="True">
                                        <Setter Property="Foreground" Value="#D13438" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EsMensajeError}" Value="False">
                                        <Setter Property="Foreground" Value="#107C41" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- USUARIO -->
                <TextBlock Text="Nombre de Usuario:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="ej. admin"
                            Height="38"
                            Margin="0,0,0,12" />

                <!-- CONTRASEÑA -->
                <TextBlock Text="Contraseña:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <PasswordBox x:Name="TxtPassword"
                             Height="38"
                             FontSize="14"
                             Padding="8,6"
                             PasswordChanged="TxtPassword_PasswordChanged"
                             Margin="0,0,0,18" />

                <!-- BOTONES INGRESAR Y SALIR -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0"
                               Content="INGRESAR"
                               Icon="{ui:SymbolIcon Symbol=ArrowRight24}"
                               Appearance="Primary"
                               Height="44"
                               FontWeight="Bold"
                               HorizontalAlignment="Stretch"
                               IsDefault="True"
                               Command="{Binding IngresarCommand}" />

                    <ui:Button Grid.Column="1"
                               Content="Salir"
                               Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                               Appearance="Secondary"
                               Height="44"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               Padding="16,0"
                               IsCancel="True"
                               Command="{Binding SalirCommand}" />
                </Grid>
            </StackPanel>

            <!-- PIE DE VENTANA CON ESTADO DE LICENCIA Y FIRMA MR SYS -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Padding="12,10"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LicenciaTexto}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Content="Renovar"
                                   Appearance="Secondary"
                                   FontSize="11"
                                   Padding="8,4"
                                   Margin="8,0,0,0"
                                   Command="{Binding AbrirActivacionCommand}" />
                    </Grid>
                </Border>

                <!-- FIRMA DE MARCA -->
                <TextBlock Text="POWERED BY [MR_SYS] • Terminal POS v1.0 • mrsys.app"
                           FontSize="10"
                           FontFamily="Consolas, Cascadia Mono, Courier New"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
