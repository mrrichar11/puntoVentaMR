<UserControl x:Class="PuntoDeVenta.UI.Views.Proveedores.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PuntoDeVenta.UI.Converters"
             xmlns:prov="clr-namespace:PuntoDeVenta.Domain.Entities.Proveedores;assembly=PuntoDeVenta.Domain"
             xmlns:finanzas="clr-namespace:PuntoDeVenta.Domain.Entities.Finanzas;assembly=PuntoDeVenta.Domain"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1180">

    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BANNER DE MENSAJES -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Mensaje}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Proveedores &amp; Recepción de Compras" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <TabControl Grid.Row="1">

            <!-- PESTAÑA 1: INGRESO DE COMPRAS Y REMITOS -->
            <TabItem Header="Ingreso de Factura / Remito de Compra">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- SECCIÓN IZQUIERDA: DETALLE DE MERCADERÍA RECIBIDA -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Datos del Proveedor y Comprobante -->
                        <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Proveedor Emisor:" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorCompra}" DisplayMemberPath="RazonSocial" Height="34" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Text="Nro. Factura / Remito:" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding NumeroFactura, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. 0001-00045123" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="Condición de Compra:" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox SelectedValue="{Binding CondicionCompra}" SelectedValuePath="Tag" Height="34">
                                        <ComboBoxItem Content="Cuenta Corriente (A Plazo)" Tag="{x:Static prov:CondicionCompraProveedor.CuentaCorrienteAPlazo}" IsSelected="True" />
                                        <ComboBoxItem Content="Contado Efectivo (Caja)" Tag="{x:Static prov:CondicionCompraProveedor.ContadoEfectivo}" />
                                        <ComboBoxItem Content="Contado Transferencia" Tag="{x:Static prov:CondicionCompraProveedor.ContadoTransferencia}" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- Buscador y Agregador de Variante -->
                        <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Agregar Productos Recibidos al Remito" FontWeight="Bold" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" PlaceholderText="Buscar variante por SKU, nombre, modelo, talle o color..." Text="{Binding BusquedaVarianteTexto, UpdateSourceTrigger=PropertyChanged}">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding BuscarVariantesParaCompraCommand}" />
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                    <ui:Button Grid.Column="1" Content="Buscar" Margin="6,0,0,0" Command="{Binding BuscarVariantesParaCompraCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Variante Encontrada:" FontSize="11" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding VariantesEncontradas}" SelectedItem="{Binding VarianteSeleccionadaParaCompra}" DisplayMemberPath="SKU" Height="34" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                        <TextBlock Text="Cantidad Recibida:" FontSize="11" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding CantidadCompra, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                        <TextBlock Text="Costo Unitario ($):" FontSize="11" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding CostoCompraUnitario, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="3" Content="+ Agregar al Remito" Appearance="Primary" VerticalAlignment="Bottom" Height="34" Command="{Binding AgregarLineaCompraCommand}" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Tabla del Remito Actual -->
                        <ui:Card Grid.Row="2" Padding="0">
                            <DataGrid ItemsSource="{Binding LineasCompra}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="SemiBold" Width="140" />
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" />
                                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad}" FontWeight="Bold" Width="90" />
                                    <DataGridTextColumn Header="COSTO UNIT." Binding="{Binding CostoUnitario, Converter={StaticResource CurrencyConverter}}" Width="100" />
                                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ui:Card>
                    </Grid>

                    <!-- SECCIÓN DERECHA: TOTAL Y CONFIRMACIÓN DE INGRESO -->
                    <ui:Card Grid.Column="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Resumen de la Compra" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="14" CornerRadius="8" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="IMPORTE TOTAL DE FACTURA:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding TotalCompraCalculado, Converter={StaticResource CurrencyConverter}}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Observaciones / Detalle adicional:" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding ObservacionesCompra, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. Envío por Expreso Luján, 2 bultos" Margin="0,0,0,16" />

                            <Border Background="#F3F9FD" BorderBrush="#0078D4" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,20">
                                <TextBlock Text="Nota: Al confirmar la compra, las unidades recibidas se sumarán INMEDIATAMENTE al stock disponible y el costo de reposición se actualizará." FontSize="11" Foreground="#004E8C" TextWrapping="Wrap" />
                            </Border>

                            <ui:Button Content="CONFIRMAR COMPRA E INGRESAR AL STOCK"
                                       Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}"
                                       Appearance="Primary"
                                       Height="46"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Stretch"
                                       Command="{Binding RegistrarCompraMercaderiaCommand}" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 2: HISTORIAL DE COMPRAS, SALDOS Y PAGOS -->
            <TabItem Header="Historial de Compras y Cuentas a Pagar">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Grilla de Compras -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Historial de Comprobantes Recibidos" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

                        <ui:Card Grid.Row="1" Padding="0">
                            <DataGrid ItemsSource="{Binding HistorialCompras}"
                                      SelectedItem="{Binding CompraSeleccionada}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat='dd/MM/yy'}" Width="90" />
                                    <DataGridTextColumn Header="COMPROBANTE" Binding="{Binding NumeroComprobante}" FontWeight="SemiBold" Width="130" />
                                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding ProveedorNombre}" Width="*" />
                                    <DataGridTextColumn Header="CONDICIÓN" Binding="{Binding Condicion}" Width="130" />
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalCompra, Converter={StaticResource CurrencyConverter}}" Width="95" />
                                    <DataGridTextColumn Header="PAGADO" Binding="{Binding TotalPagado, Converter={StaticResource CurrencyConverter}}" Width="95" />
                                    <DataGridTextColumn Header="SALDO DEUDA" Binding="{Binding SaldoPendiente, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#C42B1C" Width="105" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ui:Card>
                    </Grid>

                    <!-- Panel Lateral: Pago de Deuda y Asentamiento de Deuda Previa -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <!-- CARD 1: ASENTAR PAGO A PROVEEDOR -->
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Asentar Pago a Proveedor" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="Seleccione una factura con saldo adeudado para registrar la entrega de dinero."
                                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="10" CornerRadius="6" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Factura Seleccionada:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding CompraSeleccionada.NumeroComprobante, FallbackValue='(Seleccione un comprobante)'}" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="{Binding CompraSeleccionada.ProveedorNombre}" FontSize="12" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding CompraSeleccionada.SaldoPendiente, StringFormat='Saldo Pendiente: {0:C}'}" FontWeight="Bold" Foreground="#C42B1C" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Importe a Abonar ($):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding MontoPagoProveedor, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                                    <TextBlock Text="Canal / Origen de los Fondos:" Margin="0,0,0,4" />
                                    <ComboBox SelectedValue="{Binding CanalPagoProveedor}" SelectedValuePath="Tag" Height="36" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Efectivo (Egresa de Caja Abierta)" Tag="{x:Static finanzas:CanalDinero.Efectivo}" IsSelected="True" />
                                        <ComboBoxItem Content="Transferencia Bancaria" Tag="{x:Static finanzas:CanalDinero.TransferenciaQR}" />
                                        <ComboBoxItem Content="Otro Medio" Tag="{x:Static finanzas:CanalDinero.Otro}" />
                                    </ComboBox>

                                    <TextBlock Text="Nro. de Transferencia / Recibo:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding ReferenciaPagoProveedor, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. Transf Banco 120482" Margin="0,0,0,16" />

                                    <ui:Button Content="REGISTRAR PAGO AL PROVEEDOR"
                                               Icon="{ui:SymbolIcon Symbol=Money24}"
                                               Appearance="Primary"
                                               Height="42"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Stretch"
                                               Command="{Binding RegistrarPagoAProveedorCommand}" />
                                </StackPanel>
                            </ui:Card>

                            <!-- CARD 2: ASENTAR FACTURA / DEUDA PREVIA AL SISTEMA -->
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Registrar Deuda Previa al Sistema" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBlock Text="Asienta facturas anteriores de fábrica adeudadas al proveedor seleccionado, sin requerir cargar prendas una por una."
                                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                    <TextBlock Text="Monto Adeudado ($):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding MontoDeudaPrevia, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />

                                    <TextBlock Text="Nro. Factura / Comprobante:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding NumeroFacturaPrevia, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. FAC-0002-0001923" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Fecha Factura:" Margin="0,0,0,4" />
                                            <DatePicker SelectedDate="{Binding FechaDeudaPrevia}" Height="34" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Vencimiento (opc):" Margin="0,0,0,4" />
                                            <DatePicker SelectedDate="{Binding FechaVencimientoDeudaPrevia}" Height="34" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Detalle / Motivo:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding DetalleDeudaPrevia, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                                    <ui:Button Content="ASENTAR FACTURA PREVIA"
                                               Icon="{ui:SymbolIcon Symbol=Receipt24}"
                                               Appearance="Secondary"
                                               Height="38"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Stretch"
                                               Command="{Binding RegistrarDeudaPreviaCommand}" />
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 3: ALTA DE PROVEEDORES -->
            <TabItem Header="Registrar Nuevo Proveedor">
                <Grid Margin="0,12,0,0">
                    <ui:Card MaxWidth="680" HorizontalAlignment="Left" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Ficha de Nuevo Proveedor" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="Cargue los datos de fabricantes y distribuidores para vincular remitos de compra y cuentas corrientes."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="Razón Social / Nombre Comercial:" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding RazonSocial, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. Textil Avellaneda SA" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="CUIT:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Cuit, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="30-12345678-9" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Nombre de Contacto / Viajante:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Teléfono / WhatsApp:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Plazo de Pago Habitual (Días):" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding PlazoPagoDias, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Email (opcional):" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Dirección / Localidad:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Datos Bancarios / Observaciones Comerciales:" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. CBU/Alias para pagos, días de visita de vendedor, etc." Margin="0,0,0,12" />

                            <!-- DEUDA PREVIA AL SISTEMA -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Deuda Previa / Saldo Inicial a Pagar (Opcional)" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Si ya le adeudabas facturas a este proveedor antes de instalar el sistema, cargalas aquí para llevar el control de pagos. No afectará el stock ni la caja." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Saldo Inicial ($):" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding SaldoInicial, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Nro. Factura / Comprobante:" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding NumeroComprobanteSaldoInicial, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. FC-0001-00028192"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Detalle / Observación de la deuda:" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding DetalleSaldoInicial, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>

                            <ui:Button Content="GUARDAR PROVEEDOR"
                                       Icon="{ui:SymbolIcon Symbol=Building24}"
                                       Appearance="Primary"
                                       Height="42"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Stretch"
                                       Command="{Binding GuardarNuevoProveedorCommand}" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 4: EDICIÓN DE PROVEEDORES -->
            <TabItem Header="Editar Proveedor Seleccionado">
                <Grid Margin="0,12,0,0">
                    <ui:Card MaxWidth="680" HorizontalAlignment="Left" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Editar Ficha de Proveedor" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="Modifique la razón social, contactos, datos bancarios o plazos del proveedor seleccionado."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="Razón Social / Nombre Comercial:" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding EditRazonSocial, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="CUIT:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding EditCuit, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Nombre de Contacto / Viajante:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding EditNombreContacto, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Teléfono / WhatsApp:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding EditTelefono, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Plazo de Pago Habitual (Días):" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding EditPlazoPagoDias, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Email:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Dirección / Localidad:" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding EditDireccion, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Datos Bancarios / Observaciones Comerciales:" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding EditNotas, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                            <ui:Button Content="GUARDAR CAMBIOS EN PROVEEDOR"
                                       Icon="{ui:SymbolIcon Symbol=Save24}"
                                       Appearance="Primary"
                                       Height="42"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Stretch"
                                       Command="{Binding GuardarEdicionProveedorCommand}" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
