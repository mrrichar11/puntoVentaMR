<UserControl x:Class="PuntoDeVenta.UI.Views.Inventario.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PuntoDeVenta.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1180">

    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- MENSAJE DE ESTADO INFORMATIVO -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Mensaje}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsMensajeError}" Value="True">
                                    <Setter Property="Foreground" Value="#D13438" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EsMensajeError}" Value="False">
                                    <Setter Property="Foreground" Value="#107C41" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="Catálogo &amp; Control de Inventario" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- PESTAÑAS PRINCIPALES -->
        <TabControl Grid.Row="1">

            <!-- PESTAÑA 1: INVENTARIO, EDICIÓN Y AJUSTES DE STOCK -->
            <TabItem Header="Inventario y Edición de Productos">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- TABLA DE VARIANTES -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Barra de Escaneo Rápido con Lector Óptico -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📷 Lector de Códigos:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" FontSize="12" />
                                <ui:TextBox Grid.Column="1"
                                            PlaceholderText="Escanear código de barras con pistola láser para buscar/seleccionar o precargar alta (Enter)..."
                                            Text="{Binding CodigoBarrasEscaneoRapido, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding BuscarPorCodigoBarrasCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                                <ui:Button Grid.Column="2"
                                           Content="Escanear / Buscar"
                                           Icon="{ui:SymbolIcon Symbol=Search24}"
                                           Margin="8,0,0,0"
                                           Command="{Binding BuscarPorCodigoBarrasCommand}" />
                            </Grid>
                        </Border>

                        <!-- Buscador -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        PlaceholderText="Buscar por SKU, código de barras, nombre, modelo, talle o color..."
                                        Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding FiltrarVariantesCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <ui:Button Grid.Column="1"
                                       Content="Filtrar"
                                       Icon="{ui:SymbolIcon Symbol=Filter24}"
                                       Margin="8,0,0,0"
                                       Command="{Binding FiltrarVariantesCommand}" />
                        </Grid>

                        <!-- Grilla de Variantes -->
                        <ui:Card Grid.Row="2" Padding="0">
                            <DataGrid ItemsSource="{Binding Variantes}"
                                      SelectedItem="{Binding VarianteSeleccionada}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="SemiBold" Width="130" />
                                    <DataGridTextColumn Header="PRODUCTO" Binding="{Binding NombreArticulo}" Width="*" />
                                    <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="65" />
                                    <DataGridTextColumn Header="COLOR" Binding="{Binding Color}" Width="85" />
                                    <DataGridTextColumn Header="STOCK" Binding="{Binding StockActual}" FontWeight="Bold" Width="70" />
                                    <DataGridTextColumn Header="COSTO" Binding="{Binding PrecioCosto, Converter={StaticResource CurrencyConverter}}" Width="85" />
                                    <DataGridTextColumn Header="PRECIO LISTA" Binding="{Binding PrecioLista, Converter={StaticResource CurrencyConverter}}" Width="95" />
                                    <DataGridTextColumn Header="SALE" Binding="{Binding PrecioOferta, Converter={StaticResource CurrencyConverter}}" Width="85" />
                                    <DataGridTemplateColumn Width="40" Header="🏷️">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Content="🏷️"
                                                           Appearance="Transparent"
                                                           Padding="0"
                                                           Width="30" Height="26"
                                                           ToolTip="Imprimir etiqueta térmica de código de barras"
                                                           Command="{Binding DataContext.ImprimirEtiquetasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                           Appearance="Transparent"
                                                           Padding="0"
                                                           Width="30" Height="26"
                                                           ToolTip="Eliminar esta variante"
                                                           Command="{Binding DataContext.EliminarVarianteFilaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ui:Card>
                    </Grid>

                    <!-- PANEL LATERAL: EDICIÓN Y AJUSTE DE STOCK -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. EDITAR DATOS DE LA VARIANTE -->
                            <ui:Card Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Editar Variante Seleccionada" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />

                                    <!-- Nombre del Producto / Artículo Padre -->
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Nombre del Producto / Artículo:" FontSize="11" />
                                        <ui:TextBox Text="{Binding EditNombreArticulo, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="SKU:" FontSize="11" />
                                            <ui:TextBox Text="{Binding EditSku, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Código Barras:" FontSize="11" />
                                            <ui:TextBox Text="{Binding EditCodigoBarras, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Talle:" FontSize="11" />
                                            <ui:TextBox Text="{Binding EditTalle, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Color:" FontSize="11" />
                                            <ui:TextBox Text="{Binding EditColor, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Costo ($):" FontSize="11" />
                                            <ui:TextBox Text="{Binding EditPrecioCosto, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Precio Lista ($):" FontSize="11" />
                                            <ui:TextBox Text="{Binding EditPrecioLista, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- PRECIO SUGERIDO EN EDICIÓN -->
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="8,5"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TextoEditPrecioSugerido}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <ui:Button Grid.Column="1"
                                                       Content="Usar"
                                                       Appearance="Secondary"
                                                       FontSize="10"
                                                       Height="24"
                                                       Padding="8,0"
                                                       Margin="4,0,0,0"
                                                       Command="{Binding AplicarEditPrecioSugeridoCommand}" />
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Precio Sale ($):" FontSize="11" />
                                            <ui:TextBox Text="{Binding EditPrecioOferta, UpdateSourceTrigger=LostFocus}" PlaceholderText="Opcional" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Stock Mínimo:" FontSize="11" />
                                            <ui:TextBox Text="{Binding EditStockMinimo, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="Permite acumular descuento por pago efectivo"
                                              IsChecked="{Binding EditPermiteDescuentoMedioPago}"
                                              FontSize="11" Margin="0,2,0,8" />

                                    <ui:Button Content="GUARDAR CAMBIOS"
                                               Appearance="Primary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,0,6"
                                               Command="{Binding GuardarEdicionVarianteCommand}" />

                                    <ui:Button Content="🏷️ Imprimir Etiqueta Térmica"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,0,8"
                                               ToolTip="Abre el asistente de impresión térmica para esta prenda"
                                               Command="{Binding ImprimirEtiquetasCommand}"
                                               CommandParameter="{Binding VarianteSeleccionada}" />

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0"
                                                   Content="🗑️ Eliminar Variante"
                                                   Appearance="Danger"
                                                   FontSize="11"
                                                   Margin="0,0,4,0"
                                                   HorizontalAlignment="Stretch"
                                                   ToolTip="Elimina solo la variante seleccionada"
                                                   Command="{Binding EliminarVarianteSeleccionadaCommand}" />
                                        <ui:Button Grid.Column="1"
                                                   Content="🗑️ Eliminar Todo"
                                                   Appearance="Secondary"
                                                   FontSize="11"
                                                   Margin="4,0,0,0"
                                                   HorizontalAlignment="Stretch"
                                                   ToolTip="Elimina el modelo padre y todas sus variantes del catálogo"
                                                   Command="{Binding EliminarArticuloCompletoCommand}" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- 2. AJUSTE RÁPIDO DE STOCK -->
                            <ui:Card Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Ajuste Rápido de Stock" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />

                                    <TextBlock Text="Cantidad a Modificar (+ ingreso / - egreso):" FontSize="11" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding CantidadAjuste, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" FontWeight="Bold" />

                                    <TextBlock Text="Motivo del Ajuste:" FontSize="11" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding MotivoAjuste, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Text="Remito / Comprobante (opcional):" FontSize="11" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding ComprobanteAjuste, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                    <ui:Button Content="APLICAR AJUSTE DE STOCK"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Command="{Binding GuardarAjusteStockCommand}" />
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 2: ACTUALIZACIÓN MASIVA DE PRECIOS POR ARTÍCULO -->
            <TabItem Header="Actualización Masiva de Precios">
                <Grid Margin="0,12,0,0">
                    <ui:Card MaxWidth="700" HorizontalAlignment="Left" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Aumento o Modificación Masiva de Precios" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="Seleccione un modelo/artículo base para actualizar los precios de todas sus variantes en lote."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="Artículo / Modelo a actualizar:" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ArticulosExistentes}"
                                      SelectedItem="{Binding ArticuloSeleccionadoParaPrecios}"
                                      DisplayMemberPath="Nombre"
                                      Height="36" Margin="0,0,0,16" />

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="1. Actualización de Precios de Lista (Venta al Público)" FontWeight="Bold" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="% Aumento sobre Lista Actual:" FontSize="11" Margin="0,0,0,4" />
                                            <ui:TextBox Text="{Binding MasivoAumentoListaPorcentaje, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. 15 (para +15%)" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="O Nuevo Precio Lista Fijo ($):" FontSize="11" Margin="0,0,0,4" />
                                            <ui:TextBox Text="{Binding MasivoNuevoPrecioLista, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. 35000" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="2. Actualización de Costos de Compra" FontWeight="Bold" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="% Aumento sobre Costo:" FontSize="11" Margin="0,0,0,4" />
                                            <ui:TextBox Text="{Binding MasivoAumentoCostoPorcentaje, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. 10" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="O Nuevo Costo Fijo ($):" FontSize="11" Margin="0,0,0,4" />
                                            <ui:TextBox Text="{Binding MasivoNuevoPrecioCosto, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ej. 16000" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="3. Liquidación / Sale Opcional" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="Nuevo Precio de Oferta ($) (0 para quitar oferta):" FontSize="11" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding MasivoNuevoPrecioOferta, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Dejar vacío para no alterar" Margin="0,0,0,8" />
                                    
                                    <CheckBox Content="Permite descuento por medio de pago (efectivo)" IsChecked="{Binding MasivoPermiteDescuento}" />
                                </StackPanel>
                            </Border>

                            <ui:Button Content="APLICAR ACTUALIZACIÓN MASIVA A TODAS LAS VARIANTES"
                                       Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                       Appearance="Primary"
                                       Height="44"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Stretch"
                                       Command="{Binding AplicarActualizacionPreciosMasivaCommand}" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 3: CARGA MATRICIAL DE PRODUCTOS -->
            <TabItem Header="Cargar Nuevo Artículo (Matriz Talles x Colores)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                        <!-- 1. DATOS DEL MODELO PADRE -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="1. Identificación del Artículo / Modelo" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Código Estilo / SKU Base:" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" PlaceholderText="ej. REM-OVERSIZE-01" Text="{Binding CodigoEstilo, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button Grid.Column="1"
                                                       Content="✨ Sugerir"
                                                       Appearance="Secondary"
                                                       ToolTip="Genera un SKU inteligente basado en el nombre, marca o categoría"
                                                       Margin="4,0,0,0"
                                                       Command="{Binding SugerirCodigoEstiloCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Nombre del Producto:" Margin="0,0,0,4" />
                                        <ui:TextBox PlaceholderText="ej. Remera Algodón Peinado Oversize" Text="{Binding NombreArticulo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- SELECCIÓN Y ALTA RÁPIDA DE CATEGORÍA Y MARCA -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Categoría -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Categoría:" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}" DisplayMemberPath="Nombre" Height="34" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" PlaceholderText="Nueva categoría (ej. Camperas, Sandalias)..." Text="{Binding NuevaCategoriaNombre, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button Grid.Column="1" Content="+ Alta" Margin="4,0,0,0" Command="{Binding AgregarNuevaCategoriaCommand}" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Marca -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Marca:" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Marcas}" SelectedItem="{Binding MarcaSeleccionada}" DisplayMemberPath="Nombre" Height="34" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" PlaceholderText="Nueva marca (ej. Zara, Adidas)..." Text="{Binding NuevaMarcaNombre, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button Grid.Column="1" Content="+ Alta" Margin="4,0,0,0" Command="{Binding AgregarNuevaMarcaCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Código de Barras Fábrica (Opcional):" Margin="0,0,0,4" />
                                        <ui:TextBox PlaceholderText="Escanear o dejar vacío para EAN-13 automático" Text="{Binding CodigoBarrasNuevo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="Temporada:" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding Temporada, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Género:" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding Genero, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- 2. PRECIOS Y OFERTAS -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="2. Precios y Políticas Comerciales" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Precio Costo ($):" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding PrecioCosto, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                        <TextBlock Text="Precio Lista Regular ($):" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding PrecioLista, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                        <TextBlock Text="Precio Oferta / Sale ($):" Margin="0,0,0,4" />
                                        <ui:TextBox PlaceholderText="Opcional (vacío si es regular)" Text="{Binding PrecioOferta, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- BANNER INTERACTIVO DE PRECIO SUGERIDO -->
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TextoPrecioSugerido}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="1"
                                                   Content="⚡ Aplicar a Precio Lista"
                                                   Appearance="Secondary"
                                                   FontSize="11"
                                                   Height="30"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding AplicarPrecioSugeridoCommand}" />
                                    </Grid>
                                </Border>

                                <CheckBox Content="Permite acumular descuento por medio de pago (ej. 10% en efectivo sobre liquidación)"
                                          IsChecked="{Binding PermiteDescuentoMedioPago}"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:Card>

                        <!-- 3. MATRIZ DE TALLES Y COLORES -->
                        <ui:Card Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="3. Matriz Combinatoria de Variantes (Talles x Colores)" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="Seleccione una curva de talles predefinida o ingrese los valores separados por coma."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,12" />

                                <!-- Botones de Curvas Rápidas -->
                                <TextBlock Text="Plantillas de Curvas Rápidas:" FontWeight="Medium" Margin="0,0,0,6" />
                                <WrapPanel Margin="0,0,0,12">
                                    <ui:Button Content="Adultos Letras (S a XXL)" Appearance="Secondary" Margin="0,0,6,6" Command="{Binding AplicarCurvaTallesCommand}" CommandParameter="letras_completas" />
                                    <ui:Button Content="Adultos Números (1 al 6)" Appearance="Secondary" Margin="0,0,6,6" Command="{Binding AplicarCurvaTallesCommand}" CommandParameter="adultos_numeros" />
                                    <ui:Button Content="Pantalones Jeans (38 a 48)" Appearance="Secondary" Margin="0,0,6,6" Command="{Binding AplicarCurvaTallesCommand}" CommandParameter="denim" />
                                    <ui:Button Content="Calzado (38 a 44)" Appearance="Secondary" Margin="0,0,6,6" Command="{Binding AplicarCurvaTallesCommand}" CommandParameter="calzado" />
                                    <ui:Button Content="Infantil (4 a 14)" Appearance="Secondary" Margin="0,0,6,6" Command="{Binding AplicarCurvaTallesCommand}" CommandParameter="infantil" />
                                    <ui:Button Content="Talle Único (U)" Appearance="Secondary" Margin="0,0,6,6" Command="{Binding AplicarCurvaTallesCommand}" CommandParameter="unico" />
                                </WrapPanel>

                                <TextBlock Text="Talles de la Matriz (separados por coma):" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding TallesInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" FontWeight="SemiBold" />

                                <TextBlock Text="Colores de la Matriz (separados por coma):" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding ColoresInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" FontWeight="SemiBold" />

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Stock Inicial por Cada Variante:" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding StockInicialDefecto, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Stock Mínimo de Alerta:" Margin="0,0,0,4" />
                                        <ui:TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <ui:Button Content="GENERAR ARTÍCULO Y VARIANTES EN INVENTARIO"
                                           Icon="{ui:SymbolIcon Symbol=AddSquare24}"
                                           Appearance="Primary"
                                           Height="46"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding CrearArticuloMatrizCommand}" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
