<UserControl x:Class="PuntoDeVenta.UI.Views.Analiticas.AnaliticasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PuntoDeVenta.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1150">

    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR CON SELECTOR DE PERÍODO -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Analíticas &amp; Rendimiento Comercial" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding Mensaje}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- BOTONES RÁPIDOS DE FILTRO -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Período:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:Button Content="Hoy (Día)" Margin="2,0" Padding="10,4" Command="{Binding CambiarPeriodoCommand}" CommandParameter="dia" />
                    <ui:Button Content="Esta Semana" Margin="2,0" Padding="10,4" Command="{Binding CambiarPeriodoCommand}" CommandParameter="semana" />
                    <ui:Button Content="Este Mes" Margin="2,0" Padding="10,4" Appearance="Primary" Command="{Binding CambiarPeriodoCommand}" CommandParameter="mes" />
                    <ui:Button Content="Este Año" Margin="2,0" Padding="10,4" Command="{Binding CambiarPeriodoCommand}" CommandParameter="año" />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Margin="4,0,0,0" Padding="8,4" Command="{Binding CargarReporteCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- TARJETAS DE INDICADORES CLAVE (KPIS) -->
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <!-- KPI 1: Facturación Total -->
                    <ui:Card Padding="16" Margin="0,0,6,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="FACTURACIÓN TOTAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:SymbolIcon Symbol="Money24" HorizontalAlignment="Right" Foreground="#0078D4" />
                            </Grid>
                            <TextBlock Text="{Binding Reporte.TotalFacturado, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="ExtraBold" Foreground="#0078D4" />
                            <TextBlock Text="Total cobrado en el período" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <!-- KPI 2: Ganancia Bruta Real -->
                    <ui:Card Padding="16" Margin="3,0,3,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="GANANCIA BRUTA REAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:SymbolIcon Symbol="ArrowTrending24" HorizontalAlignment="Right" Foreground="#107C41" />
                            </Grid>
                            <TextBlock Text="{Binding Reporte.GananciaBrutaReal, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="ExtraBold" Foreground="#107C41" />
                            <TextBlock Text="{Binding Reporte.MargenBrutoPorcentual, StringFormat='Margen Bruto: {0}%' }" FontWeight="SemiBold" FontSize="11" Foreground="#107C41" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <!-- KPI 3: Cantidad de Ventas y Ticket Promedio -->
                    <ui:Card Padding="16" Margin="3,0,3,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="OPERACIONES &amp; TICKET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:SymbolIcon Symbol="ShoppingBag24" HorizontalAlignment="Right" Foreground="#D83B01" />
                            </Grid>
                            <TextBlock Text="{Binding Reporte.CantidadVentas, StringFormat='{}{0} ventas' }" FontSize="22" FontWeight="ExtraBold" />
                            <TextBlock Text="{Binding Reporte.TicketPromedio, Converter={StaticResource CurrencyConverter}, StringFormat='Ticket Promedio: {0}'}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <!-- KPI 4: Ventas Mostrador vs Web -->
                    <ui:Card Padding="16" Margin="6,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="CANALES DE VENTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:SymbolIcon Symbol="Globe24" HorizontalAlignment="Right" Foreground="#8764B8" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Mostrador Local:" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Reporte.TotalVentasMostrador, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Web / WhatsApp:" FontSize="12" FontWeight="SemiBold" Foreground="#0078D4" />
                                <TextBlock Text="{Binding Reporte.TotalVentasWeb, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#0078D4" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </UniformGrid>

                <!-- SECCIÓN MEDIA: TOP PRODUCTOS Y DESGLOSE POR MEDIO DE PAGO -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- TOP 10 PRODUCTOS MÁS VENDIDOS -->
                    <ui:Card Grid.Column="0" Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Top 10 Productos Más Vendidos" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Reporte.TopProductos}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="SemiBold" Width="140" />
                                    <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Descripcion}" Width="*" />
                                    <DataGridTextColumn Header="UNIDADES" Binding="{Binding CantidadVendida}" FontWeight="Bold" Width="80" />
                                    <DataGridTextColumn Header="TOTAL VENDIDO" Binding="{Binding TotalRecaudado, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" Width="110" />
                                    <DataGridTextColumn Header="GANANCIA" Binding="{Binding GananciaBruta, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#107C41" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ui:Card>

                    <!-- DESGLOSE POR MEDIO DE PAGO -->
                    <ui:Card Grid.Column="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Facturación por Medio de Pago" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                            <Grid Margin="0,4">
                                <TextBlock Text="💵 Efectivo en Caja:" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="{Binding Reporte.TotalEfectivo, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>

                            <Grid Margin="0,4">
                                <TextBlock Text="💳 Tarjeta de Débito:" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="{Binding Reporte.TotalTarjetaDebito, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>

                            <Grid Margin="0,4">
                                <TextBlock Text="💳 Tarjeta de Crédito:" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="{Binding Reporte.TotalTarjetaCredito, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>

                            <Grid Margin="0,4">
                                <TextBlock Text="📱 Transferencias / QR:" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="{Binding Reporte.TotalTransferencia, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>

                            <Grid Margin="0,4">
                                <TextBlock Text="📑 Cuenta Corriente / Fiados:" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="{Binding Reporte.TotalCuentaCorriente, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#D13438" />
                            </Grid>

                            <Separator Margin="0,8" />

                            <Grid Margin="0,2">
                                <TextBlock Text="Prendas / Artículos Totales:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Reporte.CantidadPrendasVendidas, StringFormat='{}{0} unidades'}" HorizontalAlignment="Right" FontWeight="Bold" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- TABLA HISTORIAL DE VENTAS DEL PERÍODO -->
                <ui:Card Padding="14">
                    <StackPanel>
                        <TextBlock Text="Detalle de Ventas del Período" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Reporte.VentasDetalle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TICKET" Binding="{Binding NumeroComprobante}" FontWeight="SemiBold" Width="130" />
                                <DataGridTextColumn Header="FECHA / HORA" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="120" />
                                <DataGridTextColumn Header="CLIENTE" Binding="{Binding ClienteNombre}" Width="*" />
                                <DataGridTextColumn Header="CANAL" Binding="{Binding CanalVenta}" Width="100" />
                                <DataGridTextColumn Header="PEDIDO WEB" Binding="{Binding NroPedidoWeb}" Width="100" />
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalCobrado, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Width="110" />
                                <DataGridTextColumn Header="GANANCIA" Binding="{Binding GananciaBruta, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#107C41" Width="100" />
                                <DataGridTextColumn Header="MEDIOS DE PAGO" Binding="{Binding MediosPago}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
