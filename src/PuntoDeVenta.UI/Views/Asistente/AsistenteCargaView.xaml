<UserControl x:Class="PuntoDeVenta.UI.Views.Asistente.AsistenteCargaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PuntoDeVenta.UI.Converters"
             xmlns:asistente="clr-namespace:PuntoDeVenta.Application.DTOs.Asistente;assembly=PuntoDeVenta.Application"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1150">

    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <!-- VISTA MODO A: PLAN PREMIUM ACTIVO (CHAT + MATRICES) -->
        <Grid Visibility="{Binding EsPlanPremiumActivo, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CABECERA DEL ASISTENTE -->
            <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[MR_BOT]" FontSize="18" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, monospace" Foreground="#00FF66" Margin="0,0,8,0" />
                            <TextBlock Text="• Asistente de Carga Masiva Inteligente" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="Conversá en lenguaje natural para generar artículos, curvas de talles y variantes sin formularios manuales."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="6" Padding="10,5" Background="#107C41" Margin="0,0,8,0">
                            <TextBlock Text="⭐ PLAN PREMIUM ACTIVO" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <ui:Button Content="Nuevo Diálogo"
                                   Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                                   Appearance="Secondary"
                                   Click="BtnNuevoDialogo_Click" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- CUERPO PRINCIPAL: CHAT (IZQ) Y BORRADOR/VISTA PREVIA (DER) -->
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- COLUMNA 1: CONVERSACIÓN CHAT -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- LISTA DE MENSAJES -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Mensajes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type asistente:MensajeChatDto}">
                                    <Grid Margin="0,6">
                                        <Border HorizontalAlignment="{Binding Alineacion}"
                                                Background="{Binding ColorFondo}"
                                                BorderBrush="{Binding ColorBorde}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                MaxWidth="620">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding NombreRemitente}"
                                                               Foreground="{Binding ColorRemitente}"
                                                               FontFamily="Consolas, Cascadia Mono, monospace"
                                                               FontSize="11"
                                                               FontWeight="Bold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FechaHora, StringFormat='{}{0:HH:mm}'}"
                                                               Foreground="{Binding ColorRemitente}"
                                                               FontSize="10"
                                                               Opacity="0.7" />
                                                </Grid>
                                                <TextBlock Text="{Binding Texto}"
                                                           Foreground="{Binding ColorTexto}"
                                                           TextWrapping="Wrap"
                                                           FontSize="13"
                                                           LineHeight="18" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- SUGERENCIAS RÁPIDAS (CHIPS) -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ejemplos:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        
                        <ui:Button Content="👕 4 Remeras Básicas Talles 3 y 4"
                                   Appearance="Secondary"
                                   Padding="8,4"
                                   FontSize="11"
                                   Margin="0,0,6,0"
                                   Command="{Binding UsarEjemploRapidoCommand}"
                                   CommandParameter="Compré 4 remeras básicas, talles 3 y 4 color blanca, costo $6000 y venta $14000" />

                        <ui:Button Content="🧥 6 Buzos Nike Talles S, M, L"
                                   Appearance="Secondary"
                                   Padding="8,4"
                                   FontSize="11"
                                   Margin="0,0,6,0"
                                   Command="{Binding UsarEjemploRapidoCommand}"
                                   CommandParameter="Ingresé 6 buzos oversize marca Nike color negro y gris talles S, M, L, costo $12000 y venta $28000" />

                        <ui:Button Content="👖 5 Jeans Mom Talle 38 y 40"
                                   Appearance="Secondary"
                                   Padding="8,4"
                                   FontSize="11"
                                   Margin="0,0,6,0"
                                   Command="{Binding UsarEjemploRapidoCommand}"
                                   CommandParameter="Ingresé 5 jeans mom talle 38 y 40 color azul, costo $15000, venta $32000" />

                        <ui:Button Content="👖👕 Remeras y Jeans Combinados"
                                   Appearance="Secondary"
                                   Padding="8,4"
                                   FontSize="11"
                                   Margin="0,0,6,0"
                                   Command="{Binding UsarEjemploRapidoCommand}"
                                   CommandParameter="Compre 2 remeras blancas talles 2 y 4 a 7000 pesos y 5 pantalones de Jeans con brillos talles 40 al 48, uno de cada talle" />
                    </StackPanel>
                </ScrollViewer>

                <!-- BARRA DE ENTRADA -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="InputTextBox"
                                Grid.Column="0"
                                PlaceholderText="Escribí lo que compraste (ej: Compré 4 remeras básicas, talles 3 y 4 color blanca, costo $6000 y venta $14000)..."
                                Text="{Binding TextoEntrada, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="InputTextBox_KeyDown"
                                FontSize="13"
                                Margin="0,0,8,0"
                                MinHeight="42" />

                    <ui:Button Grid.Column="1"
                               Content="Enviar"
                               Icon="{ui:SymbolIcon Symbol=Send24}"
                               Appearance="Primary"
                               Height="42"
                               Width="100"
                               FontWeight="Bold"
                               Command="{Binding EnviarMensajeCommand}" />
                </Grid>
            </Grid>

            <!-- COLUMNA 2: BORRADOR Y VISTA PREVIA INTERACTIVA -->
            <Grid Grid.Column="1">
                <!-- CASO A: BORRADOR EN CURSO O LISTO -->
                <ui:Card Padding="16" Visibility="{Binding TieneBorradorActivo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cabecera Borrador -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Borrador de Producto" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Variantes generadas a partir de la conversación:"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Selector de Múltiples Borradores -->
                        <Border Grid.Row="1" Margin="0,0,0,8"
                                Visibility="{Binding TieneMultiplesBorradores, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="PRODUCTOS DETECTADOS (tocá uno para ver sus detalles):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Borradores}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type asistente:BorradorCargaArticuloDto}">
                                                <ui:Button Margin="0,0,6,0"
                                                           Padding="8,5"
                                                           Appearance="Secondary"
                                                           Command="{Binding DataContext.SeleccionarBorradorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding NombreArticulo}" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0" />
                                                        <Border CornerRadius="3" Padding="4,1"
                                                                Background="{Binding EsValidoParaGuardar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="Listo" FontSize="9" Foreground="#107C41" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                </ui:Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Ficha de Datos Principales -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                    <TextBlock Text="Artículo:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BorradorActual.NombreArticulo}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                    <TextBlock Text="Marca:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BorradorActual.MarcaNombre}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,4">
                                    <TextBlock Text="Categoría:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BorradorActual.CategoriaNombre}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                    <TextBlock Text="Costo Unitario:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BorradorActual.PrecioCosto, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Precio Venta Lista:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BorradorActual.PrecioLista, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontWeight="Bold" Foreground="#107C41" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="Total Variantes:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding BorradorActual.Variantes.Count}" FontSize="13" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tabla de Variantes (Matriz) -->
                        <DataGrid Grid.Row="3"
                                  ItemsSource="{Binding BorradorActual.Variantes}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                  Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU SUGERIDO" Binding="{Binding Sku}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="55" IsReadOnly="True" />
                                <DataGridTextColumn Header="COLOR" Binding="{Binding Color}" Width="75" IsReadOnly="True" />
                                <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad}" Width="50" />
                                <DataGridTextColumn Header="PRECIO" Binding="{Binding PrecioLista, Converter={StaticResource CurrencyConverter}}" Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Botones de Acción -->
                        <StackPanel Grid.Row="4">
                            <ui:Button Content="🚀 CONFIRMAR TODOS LOS PRODUCTOS LISTOS"
                                       Appearance="Primary"
                                       Height="42"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding PuedeConfirmarTodos, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Command="{Binding ConfirmarTodosLosBorradoresCommand}" />

                            <ui:Button Content="🚀 CONFIRMAR E INGRESAR A INVENTARIO"
                                       Appearance="Primary"
                                       Height="42"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,6"
                                       IsEnabled="{Binding TieneBorradorListo}"
                                       Command="{Binding ConfirmarCargaInventarioCommand}" />

                            <ui:Button Content="Descartar este Borrador"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       Command="{Binding CancelarBorradorCommand}" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- CASO B: SIN BORRADOR ACTIVO (PLACEHOLDER INFORMATIVO) -->
                <ui:Card Padding="24" Visibility="{Binding NoTieneBorradorActivo, Converter={StaticResource BooleanToVisibilityConverter}}"
                         VerticalAlignment="Stretch">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="48" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <TextBlock Text="Vista Previa de Productos" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="A medida que converses con el asistente, acá se generará la matriz de variantes, curva de talles, costos y stock para que puedas revisarlos y confirmarlos en 1 clic."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       MaxWidth="300" />
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
        </Grid>

        <!-- VISTA MODO B: PANTALLA DE UPGRADE PREMIUM (SI EL CLIENTE TIENE PLAN ESTÁNDAR) -->
        <Grid Visibility="{Binding NoEsPlanPremiumActivo, Converter={StaticResource BooleanToVisibilityConverter}}"
              VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
            <ui:Card Padding="36" BorderBrush="#00FF66" BorderThickness="1.5">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Badge Superior -->
                    <Border HorizontalAlignment="Center" CornerRadius="12" Padding="14,6" Background="#1A00FF66" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐ MÓDULO EXCLUSIVO PREMIUM" FontSize="12" FontWeight="Bold" Foreground="#00FF66" />
                        </StackPanel>
                    </Border>

                    <!-- Título y Subtítulo -->
                    <TextBlock Text="[MR_BOT] • Asistente de Carga Masiva Inteligente"
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10" />
                    
                    <TextBlock Text="Agilizá el ingreso de mercadería en tu local cargando decenas de prendas, talles y colores en segundos hablando o escribiendo en lenguaje natural."
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="19" Margin="0,0,0,24" MaxWidth="560" />

                    <!-- Beneficios Clave -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="20,16" Margin="0,0,0,24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚡" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="Comprensión contextual de lenguaje natural con Inteligencia Artificial." FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="👕" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="Carga de múltiples artículos en una sola frase (remeras, buzos, jeans, etc.)." FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📐" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="Generación automática de curvas de talles, colores y códigos SKU sugeridos." FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="Cálculo automático de precios de venta con tu margen comercial en 1 solo clic." FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Código de Equipo -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Código de instalación de tu equipo: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CodigoInstalacion}" FontSize="12" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, monospace" Foreground="#00FF66" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Botón de Contacto WhatsApp -->
                    <ui:Button Content="💬 SOLICITAR ACTIVACIÓN POR WHATSAPP"
                               Icon="{ui:SymbolIcon Symbol=Chat24}"
                               Appearance="Primary"
                               Height="48"
                               FontWeight="Bold"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Padding="24,0"
                               Command="{Binding SolicitarActivacionWhatsAppCommand}" />

                    <TextBlock Text="Una vez contratado el módulo, recibirás tu clave de activación Premium para desbloquearlo al instante."
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
