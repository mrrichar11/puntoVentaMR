<UserControl x:Class="PuntoDeVenta.UI.Views.Asistente.AsistenteFlotanteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PuntoDeVenta.UI.Converters"
             xmlns:asistente="clr-namespace:PuntoDeVenta.Application.DTOs.Asistente;assembly=PuntoDeVenta.Application"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="430">

    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="#00E5FF"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Cabecera -->
                <RowDefinition Height="Auto" />
                <!-- Chat y acciones -->
                <RowDefinition Height="*" />
                <!-- Acciones Pendientes -->
                <RowDefinition Height="Auto" />
                <!-- Input de texto -->
                <RowDefinition Height="Auto" />
                <!-- Estado / Indicador -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. CABECERA MR_BOT -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#121214" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,8,0">
                            <TextBlock Text="[MR_BOT]" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" />
                        </Border>
                        <TextBlock Text="Copiloto IA Global" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Botón Nuevo Diálogo -->
                        <ui:Button Appearance="Transparent" Padding="6,4" ToolTip="Reiniciar conversación" Margin="0,0,4,0" Click="BtnNuevoDialogo_Click">
                            <ui:SymbolIcon Symbol="ArrowReset20" FontSize="14" />
                        </ui:Button>

                        <!-- Botón Minimizar / Cerrar -->
                        <ui:Button Appearance="Transparent" Padding="6,4" ToolTip="Cerrar Asistente (F1)" Click="BtnCerrar_Click">
                            <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Foreground="#FF5252" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. HISTORIAL DE CHAT -->
            <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="10">
                <ItemsControl ItemsSource="{Binding Mensajes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type asistente:MensajeChatDto}">
                            <Grid Margin="0,5">
                                <Border HorizontalAlignment="{Binding Alineacion}"
                                        Background="{Binding ColorFondo}"
                                        BorderBrush="{Binding ColorBorde}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        MaxWidth="350">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding NombreRemitente}"
                                                       Foreground="{Binding ColorRemitente}"
                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FechaHora, StringFormat='{}{0:HH:mm}'}"
                                                       Foreground="{Binding ColorRemitente}"
                                                       FontSize="9"
                                                       Opacity="0.7" />
                                        </Grid>
                                        <TextBlock Text="{Binding Texto}"
                                                   Foreground="{Binding ColorTexto}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   LineHeight="16" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3. TARJETAS INTERACTIVAS DE CONFIRMACIÓN -->
            <Border Grid.Row="2" Padding="10,4">
                <StackPanel>
                    <!-- Tarjeta: Deuda de Clienta (Libreta) -->
                    <Border Background="#1A2733" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,6"
                            Visibility="{Binding TieneDeudaClientePendiente, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="📋 DEUDA DE CLIENTA LISTA PARA ASENTAR" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DeudaClientePendiente.NombreCliente, StringFormat='Clienta: {0}'}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock Text="{Binding DeudaClientePendiente.Monto, Converter={StaticResource CurrencyConverter}, StringFormat='Monto: {0}'}" FontWeight="Bold" FontSize="15" Foreground="#FF5252" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding DeudaClientePendiente.Detalle, StringFormat='Motivo: {0}'}" FontSize="11" Foreground="#B0BEC5" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="✓ Confirmar en Cta Cte" Appearance="Primary" Height="34" FontWeight="Bold" Command="{Binding ConfirmarDeudaClienteCommand}"/>
                                <ui:Button Grid.Column="1" Content="Descartar" Appearance="Secondary" Height="34" Margin="6,0,0,0" Command="{Binding DescartarAccionPendienteCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta: Deuda de Proveedor -->
                    <Border Background="#2B261A" BorderBrush="#FFB74D" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,6"
                            Visibility="{Binding TieneDeudaProveedorPendiente, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="🏭 FACTURA DE PROVEEDOR (CUENTAS A PAGAR)" FontSize="10" FontWeight="Bold" Foreground="#FFB74D" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DeudaProveedorPendiente.NombreProveedor, StringFormat='Proveedor: {0}'}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock Text="{Binding DeudaProveedorPendiente.NumeroComprobante, StringFormat='Factura: {0}'}" FontSize="11" Foreground="#E0E0E0"/>
                            <TextBlock Text="{Binding DeudaProveedorPendiente.Monto, Converter={StaticResource CurrencyConverter}, StringFormat='Importe a Pagar: {0}'}" FontWeight="Bold" FontSize="15" Foreground="#FFB74D" Margin="0,2,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="✓ Asentar en Cuentas a Pagar" Appearance="Primary" Height="34" FontWeight="Bold" Command="{Binding ConfirmarDeudaProveedorCommand}"/>
                                <ui:Button Grid.Column="1" Content="Descartar" Appearance="Secondary" Height="34" Margin="6,0,0,0" Command="{Binding DescartarAccionPendienteCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta: Alta de Contacto -->
                    <Border Background="#1A2D23" BorderBrush="#00FF66" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,6"
                            Visibility="{Binding TieneContactoPendiente, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ContactoPendiente.TipoContacto, StringFormat='👤 ALTA DE {0}'}" FontSize="10" FontWeight="Bold" Foreground="#00FF66" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ContactoPendiente.Nombre, StringFormat='Nombre: {0}'}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock Text="{Binding ContactoPendiente.Telefono, StringFormat='Tel: {0}'}" FontSize="11" Foreground="#B0BEC5"/>
                            <TextBlock Text="{Binding ContactoPendiente.SaldoInicial, Converter={StaticResource CurrencyConverter}, StringFormat='Saldo previo: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#00FF66" Margin="0,2,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="✓ Guardar Contacto" Appearance="Primary" Height="34" FontWeight="Bold" Command="{Binding ConfirmarNuevoContactoCommand}"/>
                                <ui:Button Grid.Column="1" Content="Descartar" Appearance="Secondary" Height="34" Margin="6,0,0,0" Command="{Binding DescartarAccionPendienteCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta: Borrador de Stock Listo -->
                    <Border Background="#1C2833" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,6"
                            Visibility="{Binding TieneBorradorListo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="👕 BORRADOR DE ROPA LISTO" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding BorradorActual.NombreArticulo}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock Text="{Binding BorradorActual.CantidadTotal, StringFormat='Prendas totales: {0}'}" FontSize="11" Foreground="#B0BEC5"/>
                            <WrapPanel Margin="0,2,0,8">
                                <TextBlock Text="{Binding BorradorActual.PrecioCosto, Converter={StaticResource CurrencyConverter}, StringFormat='Costo: {0}'}" FontSize="11" Foreground="#B0BEC5" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding BorradorActual.PrecioLista, Converter={StaticResource CurrencyConverter}, StringFormat='Venta: {0}'}" FontWeight="Bold" FontSize="12" Foreground="#00FF66"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="🚀 Guardar en Inventario" Appearance="Primary" Height="34" FontWeight="Bold" Command="{Binding ConfirmarCargaInventarioCommand}"/>
                                <ui:Button Grid.Column="1" Content="Descartar" Appearance="Secondary" Height="34" Margin="6,0,0,0" Command="{Binding DescartarAccionPendienteCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. ENTRADA DE MENSAJE -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="InputTextBox"
                                Grid.Column="0"
                                PlaceholderText="Escribí o dictá (prendas, libreta, facturas)..."
                                Text="{Binding TextoEntrada, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="InputTextBox_KeyDown"
                                Height="38" />

                    <ui:Button Grid.Column="1"
                               Appearance="Primary"
                               Margin="6,0,0,0"
                               Height="38"
                               Width="44"
                               Command="{Binding EnviarMensajeCommand}"
                               ToolTip="Enviar (Enter)">
                        <ui:SymbolIcon Symbol="Send24" FontSize="16" />
                    </ui:Button>
                </Grid>
            </Border>

            <!-- 5. BARRA DE ESTADO INFERIOR -->
            <Border Grid.Row="4" Background="#121214" CornerRadius="0,0,12,12" Padding="10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MensajeEstado}" FontSize="10" Foreground="#00FF66" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Atajo: F1" FontSize="9" Foreground="#888888" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
