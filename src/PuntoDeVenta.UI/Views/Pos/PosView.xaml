<UserControl x:Class="PuntoDeVenta.UI.Views.Pos.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PuntoDeVenta.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="345" />
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: BÚSQUEDA Y CARRITO -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. AVISO Y APERTURA RÁPIDA DE CAJA (SI ESTÁ CERRADA) -->
            <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14"
                     Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                     BorderBrush="#C42B1C"
                     BorderThickness="1.5"
                     Visibility="{Binding CajaCerrada, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" Foreground="#C42B1C" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="¡La caja está CERRADA! Ingrese el dinero en efectivo con el que arranca para comenzar a vender:"
                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding InfoFondoSugerido}"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Efectivo Inicial: $" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                        <ui:TextBox Text="{Binding FondoInicialRapido, UpdateSourceTrigger=LostFocus}"
                                    Width="110" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:Button Content="Abrir Caja"
                                   Icon="{ui:SymbolIcon Symbol=LockOpen24}"
                                   Appearance="Primary"
                                   Command="{Binding AbrirCajaRapidaCommand}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- 1. BARRA DE BÚSQUEDA Y ESCÁNER LÁSER -->
            <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                PlaceholderText="Escanear código de barras (EAN-13 / SKU) o buscar por modelo, talle, color..."
                                Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="15"
                                VerticalAlignment="Center">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding BuscarOAgregarCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <ui:Button Grid.Column="1"
                               Content="Buscar / Agregar"
                               Icon="{ui:SymbolIcon Symbol=Search24}"
                               Appearance="Primary"
                               Margin="8,0,0,0"
                               Command="{Binding BuscarOAgregarCommand}" />
                </Grid>
            </ui:Card>

            <!-- 2. SUGERENCIAS DE BÚSQUEDA MANUAL (SI HAY COINCIDENCIAS) -->
            <ui:Card Grid.Row="2"
                     Margin="0,0,0,12"
                     Padding="10"
                     MaxHeight="340"
                     Visibility="{Binding TieneResultadosBusqueda, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock Text="Resultados encontrados — Haga clic en 'Agregar' para sumar al carrito:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ui:Button Content="Cerrar"
                                   Appearance="Transparent"
                                   Padding="6,2"
                                   HorizontalAlignment="Right"
                                   Command="{Binding CerrarSugerenciasCommand}" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ResultadosBusqueda}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              MaxHeight="270"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="SemiBold" Width="110" />
                            <DataGridTextColumn Header="PRODUCTO" Binding="{Binding NombreArticulo}" Width="*" MinWidth="130" />
                            <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="55" />
                            <DataGridTextColumn Header="COLOR" Binding="{Binding Color}" Width="70" />
                            <DataGridTextColumn Header="STOCK" Binding="{Binding StockActual}" FontWeight="Bold" Width="55" />
                            <DataGridTextColumn Header="PRECIO" Binding="{Binding PrecioBaseVenta, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Width="90" />
                            <DataGridTemplateColumn Header="ACCIÓN" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="Agregar"
                                                   Appearance="Primary"
                                                   Padding="6,2"
                                                   FontSize="11"
                                                   Command="{Binding DataContext.AgregarAlCarritoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <!-- 3. LISTADO DEL CARRITO DE COMPRAS -->
            <ui:Card Grid.Row="3" Padding="0">
                <DataGrid ItemsSource="{Binding Carrito}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="SemiBold" Width="110" />
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Descripcion}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="TALLE" Binding="{Binding Talle}" Width="55" />
                        <DataGridTextColumn Header="COLOR" Binding="{Binding Color}" Width="70" />
                        <DataGridTextColumn Header="PRECIO UNIT." Binding="{Binding PrecioUnitarioEfectivo, Converter={StaticResource CurrencyConverter}}" Width="95" />

                        <!-- Controles de Cantidad -->
                        <DataGridTemplateColumn Header="CANTIDAD" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:Button Content="-"
                                                   Padding="5,1"
                                                   FontSize="11"
                                                   Command="{Binding DataContext.DecrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Cantidad}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Margin="6,0"
                                                   VerticalAlignment="Center" />
                                        <ui:Button Content="+"
                                                   Padding="5,1"
                                                   FontSize="11"
                                                   Command="{Binding DataContext.IncrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SUBTOTAL" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}"
                                               FontWeight="Bold"
                                               Foreground="#107C41"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,6,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                               Appearance="Transparent"
                                               Foreground="#D13438"
                                               Padding="2"
                                               HorizontalAlignment="Center"
                                               Command="{Binding DataContext.EliminarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ui:Card>

            <!-- 4. MENSAJE DE ESTADO INFORMATIVO -->
            <TextBlock Grid.Row="4"
                       Text="{Binding MensajeEstado}"
                       Margin="4,8,0,0"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{Binding EsMensajeError, Converter={x:Null}}" />
        </Grid>

        <!-- COLUMNA DERECHA: RESUMEN Y PANEL DE COBRO (SPLIT PAYMENTS) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- RESUMEN DE TOTALES -->
            <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Resumen de Compra" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

                    <Grid Margin="0,3">
                        <TextBlock Text="Subtotal Lista:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding SubtotalLista, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Medium" />
                    </Grid>

                    <Grid Margin="0,3">
                        <TextBlock Text="Descuentos de Oferta:" Foreground="#D13438" />
                        <TextBlock Text="{Binding TotalDescuentos, Converter={StaticResource CurrencyConverter}, StringFormat='-{0}'}" HorizontalAlignment="Right" Foreground="#D13438" FontWeight="Medium" />
                    </Grid>

                    <!-- DESCUENTO BONIFICACIÓN POR EFECTIVO / TRANSFERENCIA -->
                    <Grid Margin="0,3">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AplicarDescuentoEfectivo}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="{Binding PorcentajeDescuentoEfectivo, StringFormat='Bonificación Efectivo/Transf ({0}%):'}" Foreground="#107C41" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DescuentoMedioPago, Converter={StaticResource CurrencyConverter}, StringFormat='-{0}'}" HorizontalAlignment="Right" Foreground="#107C41" FontWeight="Bold" />
                    </Grid>

                    <CheckBox Content="{Binding PorcentajeDescuentoEfectivo, StringFormat='Bonificación Efectivo/Transf ({0}%)'}"
                              IsChecked="{Binding AplicarDescuentoEfectivo}"
                              FontWeight="SemiBold"
                              Foreground="#107C41"
                              Margin="0,4,0,0" />

                    <!-- RECARGO FINANCIACIÓN EN CUOTAS (TARJETA) -->
                    <Grid Margin="0,3">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TieneRecargoFinanciacion}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="{Binding PlanCuotaSeleccionado.Cuotas, StringFormat='Recargo Tarjeta ({0} Cuotas):'}" Foreground="#D13438" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RecargoFinanciacionCredito, Converter={StaticResource CurrencyConverter}, StringFormat='+{0}'}" HorizontalAlignment="Right" Foreground="#D13438" FontWeight="Bold" />
                    </Grid>

                    <Separator Margin="0,8" />

                    <Grid Margin="0,4">
                        <TextBlock Text="TOTAL A COBRAR" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalCobrar, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="24"
                                   FontWeight="ExtraBold"
                                   Foreground="#107C41"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <!-- COMPARADOR DE 3 PRECIOS (EFECTIVO / LISTA / CUOTAS) -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Escala de Precios en Mostrador:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <UniformGrid Columns="3">
                                <!-- 1. EFECTIVO / TRANSFERENCIA -->
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="4,3" Margin="0,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="1. Efectivo (-10%)" FontSize="9.5" FontWeight="SemiBold" Foreground="#107C41" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding PrecioEfectivoTotal, Converter={StaticResource CurrencyConverter}}" FontSize="11.5" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- 2. PRECIO DE LISTA / DÉBITO -->
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="4,3" Margin="2,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="2. Lista / Débito" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding PrecioListaTotal, Converter={StaticResource CurrencyConverter}}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- 3. PRECIO CUOTAS -->
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="4,3" Margin="2,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EtiquetaTercerPrecio}" FontSize="9.5" FontWeight="SemiBold" Foreground="#0078D4" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PrecioCuotasTotal, Converter={StaticResource CurrencyConverter}}" FontSize="11.5" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding DetalleCuotasTexto}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- MEDIOS DE PAGO COMBINADOS (SPLIT PAYMENT) -->
            <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- SELECTOR DE CLIENTE & CANAL DE VENTA -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cliente &amp; Canal de Venta" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      Content="Venta Web / Redes"
                                      IsChecked="{Binding EsVentaWeb}"
                                      Foreground="#0078D4"
                                      FontWeight="SemiBold"
                                      FontSize="11"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- Input Nro Pedido Web si aplica -->
                        <StackPanel Margin="0,0,0,6" Visibility="{Binding EsVentaWeb, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBox PlaceholderText="Nro. de Pedido Web (ej. #1042 / TiendaNube / WA)"
                                        Text="{Binding NroPedidoWeb, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="11" />
                        </StackPanel>

                        <!-- Búsqueda y Selección Unificada de Cliente -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        PlaceholderText="DNI, teléfono o nombre..."
                                        Text="{Binding DniBusquedaCliente, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="11"
                                        Height="30"
                                        VerticalContentAlignment="Center">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding BuscarClientaPorDniCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <ui:Button Grid.Column="1"
                                       Icon="{ui:SymbolIcon Symbol=Search16}"
                                       Margin="4,0,0,0"
                                       Height="30"
                                       Padding="8,0"
                                       ToolTip="Buscar cliente"
                                       Command="{Binding BuscarClientaPorDniCommand}" />
                            <ui:Button Grid.Column="2"
                                       Content="Cons. Final"
                                       Appearance="Secondary"
                                       Margin="4,0,0,0"
                                       Height="30"
                                       FontSize="11"
                                       Padding="6,0"
                                       ToolTip="Restablecer a Consumidor Final"
                                       Command="{Binding QuitarClienteSeleccionadoCommand}" />
                        </Grid>

                        <!-- Desplegable Rápido (Sincronizado con la Búsqueda) -->
                        <ComboBox ItemsSource="{Binding ClientesDisponibles}"
                                  SelectedItem="{Binding ClienteSeleccionado}"
                                  DisplayMemberPath="NombreCompleto"
                                  Height="28"
                                  FontSize="11"
                                  Margin="0,0,0,4" />

                        <!-- Badge Informativo del Cliente Seleccionado -->
                        <Border Margin="0,0,0,6"
                                Padding="8,5"
                                CornerRadius="6"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{Binding InfoClientaIdentificada}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Separator Margin="0,6" />

                        <!-- ATAJOS RÁPIDOS DE PAGO TOTAL -->
                        <TextBlock Text="Medios de Pago" FontSize="14" FontWeight="Bold" Margin="0,0,0,6" />

                        <UniformGrid Columns="5" Margin="0,0,0,8">
                            <ui:Button Content="Efectivo" Margin="1" Padding="2" FontSize="11" Command="{Binding AutoCompletarEfectivoCommand}" />
                            <ui:Button Content="Transf." Margin="1" Padding="2" FontSize="11" Command="{Binding AutoCompletarTransferenciaCommand}" />
                            <ui:Button Content="Débito" Margin="1" Padding="2" FontSize="11" Command="{Binding AutoCompletarDebitoCommand}" />
                            <ui:Button Content="Crédito" Margin="1" Padding="2" FontSize="11" Command="{Binding AutoCompletarCreditoCommand}" />
                            <ui:Button Content="A Cta." Margin="1" Padding="2" FontSize="11" Command="{Binding AutoCompletarCuentaCorrienteCommand}" />
                        </UniformGrid>

                        <!-- Input Efectivo & Monto Recibido -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Monto a Cobrar ($):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox Text="{Binding PagoEfectivo, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Paga con Billete ($):" FontSize="11" Foreground="#0078D4" FontWeight="SemiBold" />
                                <ui:TextBox Text="{Binding MontoRecibidoEfectivo, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="Bold" Foreground="#0078D4" />
                            </StackPanel>
                        </Grid>

                        <!-- Billetes Rápidos -->
                        <UniformGrid Columns="4" Margin="0,0,0,6">
                            <ui:Button Content="$10.000" Padding="1" FontSize="10" Command="{Binding FijarMontoRecibidoCommand}" CommandParameter="10000" />
                            <ui:Button Content="$20.000" Padding="1" FontSize="10" Command="{Binding FijarMontoRecibidoCommand}" CommandParameter="20000" />
                            <ui:Button Content="$50.000" Padding="1" FontSize="10" Command="{Binding FijarMontoRecibidoCommand}" CommandParameter="50000" />
                            <ui:Button Content="$100.000" Padding="1" FontSize="10" Command="{Binding FijarMontoRecibidoCommand}" CommandParameter="100000" />
                        </UniformGrid>

                        <!-- Input Transferencia / QR -->
                        <TextBlock Text="Transferencia Bancaria / QR ($):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBox Text="{Binding PagoTransferencia, UpdateSourceTrigger=PropertyChanged}" Margin="0,1,0,2" FontSize="13" />
                        <ui:TextBox PlaceholderText="Nro. Comprobante / Referencia Transf." Text="{Binding ReferenciaTransferencia, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" FontSize="11" />

                        <!-- Input Tarjeta de Débito -->
                        <TextBlock Text="Tarjeta de Débito ($):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBox Text="{Binding PagoTarjetaDebito, UpdateSourceTrigger=PropertyChanged}" Margin="0,1,0,2" FontSize="13" />
                        <ui:TextBox PlaceholderText="Nro. Cupón POSNet Débito" Text="{Binding ReferenciaTarjetaDebito, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" FontSize="11" />

                        <!-- Input Tarjeta de Crédito -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tarjeta de Crédito ($):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Plan:" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding PlanesCuotasDisponibles}"
                                          SelectedItem="{Binding PlanCuotaSeleccionado, Mode=TwoWay}"
                                          DisplayMemberPath="DescripcionVisual"
                                          Height="28"
                                          MinWidth="180"
                                          FontSize="11"
                                          VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ui:TextBox Text="{Binding PagoTarjetaCredito, UpdateSourceTrigger=PropertyChanged}" Margin="0,1,0,2" FontSize="13" />
                        <ui:TextBox PlaceholderText="Nro. Cupón POSNet Crédito" Text="{Binding ReferenciaTarjetaCredito, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" FontSize="11" />

                        <!-- Input Cuenta Corriente -->
                        <TextBlock Text="A Cuenta Corriente / Fiado ($):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBox Text="{Binding PagoCuentaCorriente, UpdateSourceTrigger=PropertyChanged}" Margin="0,1,0,6" FontSize="13" FontWeight="SemiBold" />

                        <!-- Estado del Pago & Vuelto -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Total Abonado:" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding TotalAbonado, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Saldo Pendiente:" Foreground="#D13438" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding SaldoPendiente, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" Foreground="#D13438" FontWeight="Bold" FontSize="13" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="VUELTO A ENTREGAR:" Foreground="#107C41" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Vuelto, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" Foreground="#107C41" FontWeight="ExtraBold" FontSize="16" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>

            <!-- BOTONES DE ACCIÓN FINAL -->
            <StackPanel Grid.Row="2">
                <ui:Button Content="COBRAR Y GENERAR TICKET"
                           Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}"
                           Appearance="Primary"
                           Height="48"
                           FontSize="15"
                           FontWeight="Bold"
                           HorizontalAlignment="Stretch"
                           IsEnabled="{Binding PuedeCobrar}"
                           Command="{Binding ProcesarCobroCommand}" />

                <ui:Button Content="Limpiar Carrito"
                           Appearance="Secondary"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Stretch"
                           Command="{Binding LimpiarCarritoCommand}" />
            </StackPanel>
        </Grid>

        <!-- MODAL / OVERLAY DE VENTA COMPLETADA Y VUELTO -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="#99000000"
              Visibility="{Binding MostrarModalCobroExitoso, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:Card Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="52" Foreground="#107C41" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="¡COBRO REALIZADO CON ÉXITO!" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ResumenNumeroComprobante, StringFormat='Comprobante: {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />

                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <TextBlock Text="Total Cobrado:" FontSize="13" />
                                <TextBlock Text="{Binding ResumenTotalCobrado, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Dinero Recibido:" FontSize="13" />
                                <TextBlock Text="{Binding ResumenMontoRecibido, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" />
                            </Grid>

                            <Separator Margin="0,8" />

                            <Grid Margin="0,2">
                                <TextBlock Text="VUELTO A ENTREGAR:" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#107C41" />
                                <TextBlock Text="{Binding ResumenVuelto, Converter={StaticResource CurrencyConverter}}"
                                           FontWeight="ExtraBold"
                                           FontSize="26"
                                           Foreground="#107C41"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2">
                        <ui:Button Content="Ver Ticket Digital"
                                   Icon="{ui:SymbolIcon Symbol=DocumentText24}"
                                   Appearance="Secondary"
                                   Height="44"
                                   Margin="0,0,6,0"
                                   Command="{Binding AbrirTicketArchivoCommand}" />

                        <ui:Button Content="Siguiente Venta"
                                   Icon="{ui:SymbolIcon Symbol=ArrowRight24}"
                                   Appearance="Primary"
                                   Height="44"
                                   FontWeight="Bold"
                                   Margin="6,0,0,0"
                                   IsDefault="True"
                                   Command="{Binding CerrarModalVentaCompletadaCommand}" />
                    </UniformGrid>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
