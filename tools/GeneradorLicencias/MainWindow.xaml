<ui:FluentWindow x:Class="GeneradorLicencias.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Generador de Claves de Activación - Panel Desarrollador"
                  Height="600" Width="580"
                  WindowStartupLocation="CenterScreen"
                  ResizeMode="CanMinimize"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ui:SymbolIcon Symbol="Key24" FontSize="26" Foreground="#0078D4" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Generador de Licencias Mensuales" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Herramienta exclusiva de desarrollo para emitir claves criptográficas offline firmadas con HMAC-SHA256."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- FORMULARIO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- CÓDIGO DE INSTALACIÓN -->
                <ui:Card Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="1. Código de Instalación del Cliente:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Pega aquí el código que te envió tu cliente (ej. POS-DESKTOP-1A2B3C4D):"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="TxtCodigoInstalacion"
                                    PlaceholderText="ej. POS-DESKTOP-XXXXXXXX"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Height="40" />
                    </StackPanel>
                </ui:Card>

                <!-- TIPO DE PLAN -->
                <ui:Card Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2. Tipo de Plan / Módulos:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbPlanPremium"
                                         Content="⭐ Plan Premium (Con Asistente IA)"
                                         IsChecked="True"
                                         FontWeight="Bold"
                                         Foreground="#107C41"
                                         Margin="0,0,24,0"
                                         Checked="RbPlan_Checked" />
                            <RadioButton x:Name="RbPlanEstandar"
                                         Content="Plan Estándar (Sin IA)"
                                         FontWeight="SemiBold"
                                         Checked="RbPlan_Checked" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- VENCIMIENTO A OTORGAR -->
                <ui:Card Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="3. Plazo de Activación:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <ui:Button Content="+30 Días" Height="36" Margin="0,0,4,0" Click="BtnSumarDias_Click" Tag="30" />
                            <ui:Button Content="+60 Días" Height="36" Margin="2,0,2,0" Click="BtnSumarDias_Click" Tag="60" />
                            <ui:Button Content="+90 Días" Height="36" Margin="2,0,2,0" Click="BtnSumarDias_Click" Tag="90" />
                            <ui:Button Content="+1 Año" Height="36" Margin="4,0,0,0" Click="BtnSumarDias_Click" Tag="365" />
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fecha de Expiración:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <DatePicker Grid.Column="1" x:Name="DpFechaExpiracion" Height="36" SelectedDateChanged="DpFechaExpiracion_SelectedDateChanged" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- BOTÓN GENERAR -->
                <ui:Button Content="⚡ GENERAR CLAVE DE ACTIVACIÓN"
                           Appearance="Primary"
                           Height="46"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Stretch"
                           Click="BtnGenerar_Click"
                           Margin="0,0,0,14" />

                <!-- RESULTADO -->
                <ui:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="4. Clave Criptográfica Resultante:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="TxtClaveResultado"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Padding="10,8"
                                     Height="42" />
                            <ui:Button Grid.Column="1"
                                       Content="Copiar Clave"
                                       Icon="{ui:SymbolIcon Symbol=Copy24}"
                                       Appearance="Secondary"
                                       Height="42"
                                       Margin="8,0,0,0"
                                       Click="BtnCopiarClave_Click" />
                        </Grid>

                        <TextBlock Text="Mensaje listo para WhatsApp:" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="TxtMensajeWhatsApp"
                                 IsReadOnly="True"
                                 Height="55"
                                 TextWrapping="Wrap"
                                 Padding="8,6"
                                 FontSize="11"
                                 Margin="0,0,0,8" />
                        <ui:Button Content="Copiar Mensaje Completo para WhatsApp"
                                   Icon="{ui:SymbolIcon Symbol=Chat24}"
                                   Appearance="Secondary"
                                   Height="36"
                                   HorizontalAlignment="Stretch"
                                   Click="BtnCopiarWhatsApp_Click" />
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
